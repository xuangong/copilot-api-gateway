{
  "name": "copilot-gateway-vnext",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun run scripts/check-framework-purity.ts && bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "build:ui": "bun scripts/build-dashboard.ts",
    "ci:local": "bun run scripts/check-framework-purity.ts && bun run typecheck && bun test && bun run lint && bun run build:ui && bun run --filter '@vibe-llm/platform-cloudflare' deploy:dry"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}

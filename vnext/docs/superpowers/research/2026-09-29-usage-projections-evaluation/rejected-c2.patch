+      page: { rows: [{ value: "", metrics, hours: [{ hour: "2026-09-01T00", metrics }] }], hasMore: false, nextCursor: null },
+      buckets: [{ hour: "2026-09-01T00", metrics }], unfilteredHasRecords: true }),
+    { headers: { "content-type": "application/json" } })
+  }, { preconnect: prior.preconnect })
+  try {
+    const signal = new AbortController().signal
+    const query = { start: "2026-09-01T00", end: "2026-09-02T00", incoming_model: "", cursor: "p1.opaque" }
+    await fetchUsageFacetPage({ start: query.start, end: query.end, axis: "incomingModel" }, signal)
+    await fetchUsageDistributionPage({ ...query, axis: "incomingModel" }, signal)
+    const series = await fetchUsageSeriesPage({ ...query, axis: "model", limit: 1 }, signal)
+    const time = await fetchUsageTime({ start: query.start, end: query.end, incoming_model: "" }, signal)
+    expect(calls.map(call => new URL(call.url, "http://local").pathname)).toEqual([
+      "/api/token-usage/projections/facets", "/api/token-usage/projections/distribution",
+      "/api/token-usage/projections/series", "/api/token-usage/projections/time",
+    ])
+    for (const [index, call] of calls.entries()) {
+      const url = new URL(call.url, "http://local")
+      expect(url.searchParams.has("incoming_model")).toBe(index !== 0)
+      if (index !== 0) expect(url.searchParams.get("incoming_model")).toBe("")
+      expect(url.searchParams.get("cursor")).toBe(index === 1 || index === 2 ? "p1.opaque" : null)
+      expect(call.signal).toBe(signal)
+    }
+    expect(series.page.rows[0]?.hours[0]?.metrics.unpricedDimensionRows).toBe(1)
+    expect(time.buckets[0]?.metrics.observedDimensions).toEqual(["input"])

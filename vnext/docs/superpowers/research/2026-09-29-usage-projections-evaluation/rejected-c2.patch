+import { createHash } from "node:crypto"
+import { Hono, type Context } from "hono"
+import type { Env } from "../../app"
+import type { ApiKeyId, UserId } from "../../repo/branded-ids"
+import { getRepo } from "../../repo"
+import type { Repo, UsageKeyMetadata, UsageAssigneeMetadata } from "../../repo/types"
+import { validateUsageProjection, type UsageProjectionAxis, type UsageMetricAxis, type UsageSeriesAxis, type UsageProjectionQuery } from "../../repo/usage-projections"
+import { deriveViewContext } from "../lib/view-context"
+import { getServerSecret, sharedKeyRef } from "../lib/redact-shared-view"
+import type { TokenUsageAuthCtx } from "./routes"
+
+type Vars = { auth: TokenUsageAuthCtx }
+type Kind = "total" | "facets" | "participants" | "distribution" | "mappings" | "time" | "series"
+type Parsed = {
+  start: string; end: string; axis?: string; limit?: number; cursor?: string
+  keyFilter?: string; client?: string; model?: string; incomingModel?: string
+  userId?: string; asUser?: string
+}
+
+const bad = (message: string): never => { throw new Error(message) }
+const encode = (bytes: Uint8Array): string => Buffer.from(bytes).toString("base64url")
+function decode(value: string): Uint8Array<ArrayBuffer> {
+  if (!/^[A-Za-z0-9_-]+$/.test(value)) return bad("Invalid cursor")
+  const bytes = Buffer.from(value, "base64url")
+  if (bytes.toString("base64url") !== value) return bad("Invalid cursor")
+  const copy = new Uint8Array(bytes.length)
+  copy.set(bytes)
+  return copy
+}
+async function cipherKey(secret: string): Promise<CryptoKey> {
+  const source = new TextEncoder().encode(`usage-projection-cursor-v1:${secret}`)
+  const digest = await crypto.subtle.digest("SHA-256", source)
+  return crypto.subtle.importKey("raw", digest, "AES-GCM", false, ["encrypt", "decrypt"])
+}
+async function encryptCursor(secret: string, binding: string, last: string): Promise<string> {
+  const iv = crypto.getRandomValues(new Uint8Array(12))
+  const payload = new TextEncoder().encode(JSON.stringify({ version: 1, binding, last }))
+  const encrypted = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, await cipherKey(secret), payload)
+  return `p1.${encode(iv)}.${encode(new Uint8Array(encrypted))}`
+}
+async function decryptCursor(secret: string, binding: string, cursor: string): Promise<string> {
+  const parts = cursor.split(".")
+  if (parts.length !== 3 || parts[0] !== "p1" || !parts[1] || !parts[2]) return bad("Invalid cursor")
+  const iv = decode(parts[1])
+  const ciphertext = decode(parts[2])
+  if (iv.length !== 12 || ciphertext.length < 17) return bad("Invalid cursor")
+  let payload: unknown
+  try {
+    const plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, await cipherKey(secret), ciphertext)
+    payload = JSON.parse(new TextDecoder().decode(plain))
+  } catch { return bad("Invalid cursor") }
+  if (!payload || typeof payload !== "object" || !("version" in payload) || payload.version !== 1 ||
+    !("binding" in payload) || payload.binding !== binding || !("last" in payload) || typeof payload.last !== "string") return bad("Cursor scope or query changed")
+  return payload.last
+}
+
+function parse(c: Context<{ Bindings: Env; Variables: Vars }>): Parsed {
+  const query = (name: string) => c.req.query(name)
+  const limitRaw = query("limit")
+  if (limitRaw !== undefined && !/^[1-9]\d*$/.test(limitRaw)) return bad("limit must be 1..200")
+  const limit = limitRaw === undefined ? undefined : Number(limitRaw)
+  if (limit !== undefined && (!Number.isSafeInteger(limit) || limit > 200)) return bad("limit must be 1..200")
+  return { start: query("start") ?? "", end: query("end") ?? "", axis: query("axis"), limit,
+    cursor: query("cursor"), keyFilter: query("key_id") || undefined,
+    client: query("client") || undefined, model: query("model") || undefined,
+    incomingModel: query("incoming_model"), userId: query("user_id") || undefined,
+    asUser: query("as_user") || undefined }
+}
+
+function attribution(metadata: readonly UsageKeyMetadata[], assignees: readonly UsageAssigneeMetadata[]) {
+  const byKey = new Map<string, UsageAssigneeMetadata[]>()
+  for (const item of assignees) {
+    const list = byKey.get(item.keyId) ?? []
+    list.push(item)
+    byKey.set(item.keyId, list)
+  }
+  // Raw key IDs can be object-prototype property names such as "__proto__".
+  const refs: Record<string, string> = Object.create(null)
+  const members = new Map<string, Set<string>>()
+  for (const key of metadata) {
+    const people = [
+      ...(key.ownerId ? [{ id: key.ownerId, name: key.ownerName ?? key.ownerId.slice(0, 8) }] : []),
+      ...(byKey.get(key.keyId) ?? []).map(item => ({ id: item.userId, name: item.name ?? item.userId.slice(0, 8) }))
+        .sort((a, b) => a.name.localeCompare(b.name)),
+    ]
+    const legacyId = people.length > 1 ? `shared:${people.map(p => p.id).sort().join("+")}` : people[0]?.id ?? "_admin"
+    refs[key.keyId] = legacyId === "_admin" ? "_admin" : `g_${createHash("sha256").update(legacyId).digest("base64url")}`
+    members.set(key.keyId, new Set(people.map(p => p.id)))
+  }
+  return { refs, members }
+}
+
+async function loadAttribution(repo: Repo, keyIds?: readonly ApiKeyId[]) {
+  const metadata = await repo.usage.queryKeyMetadata(keyIds)
+  const assignees = metadata.length ? await repo.usage.queryAssigneeMetadata(metadata.map(item => item.keyId)) : []
+  return { metadata, ...attribution(metadata, assignees) }
+}
+
+function axisFor(kind: Kind, value: string | undefined): UsageProjectionAxis | UsageMetricAxis | UsageSeriesAxis | undefined {
+  if (kind === "facets") {
+    if (value === "key" || value === "client" || value === "model" || value === "incomingModel") return value
+    return bad("Invalid axis")
+  }
+  if (kind === "distribution") {
+    if (value === "key" || value === "client" || value === "model" || value === "incomingModel" || value === "user") return value
+    return bad("Invalid axis")
+  }
+  if (kind === "series") {
+    if (value === "key" || value === "client" || value === "model" || value === "user") return value
+    return bad("Invalid axis")
+  }
+  if (value !== undefined) return bad("Unexpected axis")
+  return undefined
+}
+
+export const projectionRouter = new Hono<{ Bindings: Env; Variables: Vars }>()
+
+async function respond(kind: Kind, c: Context<{ Bindings: Env; Variables: Vars }>) {
+  const auth = c.get("auth") ?? {}
+  if (!auth.apiKeyId && !auth.userId && !auth.isAdmin) return c.json({ error: "Unauthorized" }, 401)
+  let input: Parsed
+  let axis: ReturnType<typeof axisFor>
+  try {
+    input = parse(c)
+    axis = axisFor(kind, input.axis)
+    validateUsageProjection({ start: input.start, end: input.end }, kind === "time" || kind === "series")
+    if ((kind === "total" || kind === "time") && (input.limit !== undefined || input.cursor !== undefined)) bad("This projection does not accept pagination")
+    if ((kind === "facets" || kind === "participants") && ((!auth.apiKeyId && input.keyFilter) || input.client || input.model || input.incomingModel !== undefined || input.userId)) bad("Catalogs do not accept filters")
+  } catch (error) { return c.json({ error: error instanceof Error ? error.message : "Invalid query" }, 400) }
+
+  const repo = getRepo()
+  // A coexisting API key always wins. Still call the native resolver on every
+  // request, but prevent a session's as_user grant from widening API-key scope.
+  const view = await deriveViewContext(c, auth.apiKeyId ? { authKind: "apiKey" } : auth)
+  if ("denied" in view) return c.json({ error: "Not authorized to view this user's observability data" }, 403)
+  const isShared = !auth.apiKeyId && view.isViewingShared && !!view.ownerId
+  const isAdmin = !auth.apiKeyId && !isShared && !!auth.isAdmin
+  if ((input.userId || axis === "user") && !isAdmin) return c.json({ error: "User projection requires admin" }, 403)
+  const secret = getServerSecret(c.env as unknown as Record<string, string | undefined>)
+  let keyIds: ApiKeyId[] | undefined
+  let keyId: ApiKeyId | undefined
+  let forceEmpty = false
+  let principal: string
+  if (auth.apiKeyId) {
+    keyIds = [auth.apiKeyId]
+    principal = `api:${auth.apiKeyId}`
+  } else if (isShared && view.ownerId) {
+    const owner = view.ownerId
+    keyIds = (await repo.apiKeys.listByOwner(owner)).map(item => item.id)
+    if (input.keyFilter) {
+      keyId = keyIds.find(id => sharedKeyRef(owner, id, secret) === input.keyFilter)
+      forceEmpty = keyId === undefined
+    }
+    principal = `shared:${auth.userId}:${owner}`
+  } else if (isAdmin) {
+    keyId = input.keyFilter as ApiKeyId | undefined
+    principal = `admin:${auth.userId ?? ""}`
+  } else if (auth.userId) {
+    keyIds = await repo.apiKeys.listAccessibleIds(auth.userId)
+    keyId = input.keyFilter as ApiKeyId | undefined
+    principal = `session:${auth.userId}`
+  } else return c.json({ error: "Unauthorized" }, 401)
+
+  let fullAttribution: Awaited<ReturnType<typeof loadAttribution>> | undefined
+  if (isAdmin && (input.userId || axis === "user")) fullAttribution = await loadAttribution(repo)
+  const filterKeyIds = input.userId
+    ? fullAttribution?.metadata.filter(item => fullAttribution?.members.get(item.keyId)?.has(input.userId ?? "")).map(item => item.keyId) ?? []
+    : undefined
+  const query: UsageProjectionQuery = { start: input.start, end: input.end, keyId, keyIds,
+    filterKeyIds, forceEmpty, client: input.client, model: input.model, incomingModel: input.incomingModel }
+  const binding = JSON.stringify({ kind, axis: axis ?? null, range: [input.start, input.end],
+    filters: [auth.apiKeyId ? null : input.keyFilter ?? null, input.client ?? null, input.model ?? null,
+      input.incomingModel ?? null, input.userId ?? null, auth.apiKeyId ? null : input.asUser ?? null],
+    principal, scope: createHash("sha256").update(JSON.stringify([...(keyIds ?? [])].sort())).digest("base64url"),
+    userKeys: filterKeyIds === undefined ? null : createHash("sha256").update(JSON.stringify(filterKeyIds.slice().sort())).digest("base64url"),
+    limit: kind === "series" ? input.limit ?? 200 : null,
+    ...(kind === "series" ? { seriesBudget: "occupied-cells-v1" } : {}) })
+  let cursor: string | undefined
+  try { cursor = input.cursor === undefined ? undefined : await decryptCursor(secret, binding, input.cursor) }
+  catch (error) { return c.json({ error: error instanceof Error ? error.message : "Invalid cursor" }, 400) }
+  const pageQuery = { ...query, limit: input.limit, cursor }
+  const wrap = async <T extends { page: { rows: readonly unknown[]; hasMore: boolean; nextCursor: string | null } }>(result: T): Promise<T> => ({
+    ...result, page: { ...result.page, nextCursor: result.page.nextCursor === null ? null : await encryptCursor(secret, binding, result.page.nextCursor) },
+  }) as T
+
+  if (kind === "total") return c.json(await repo.usage.queryProjectionTotal(query))
+  if (kind === "time") return c.json(await repo.usage.queryProjectionTime(query))
+  if (kind === "mappings") return c.json(await wrap(await repo.usage.queryProjectionMappings(pageQuery)))
+  if (kind === "participants") {
+    const visibleRosterKeyIds = auth.apiKeyId || isShared ? [] : undefined
+    const visibleRosterOwnerId = !isAdmin && !auth.apiKeyId && !isShared ? auth.userId : undefined
+    const result = await repo.usage.queryProjectionParticipants({ ...pageQuery, visibleRosterKeyIds, visibleRosterOwnerId })
+    return c.json(await wrap(result))
+  }
+  if (kind === "facets" && axis && axis !== "user") {
+    const result = await repo.usage.queryProjectionFacets({ ...pageQuery, axis })
+    if (axis !== "key") return c.json(await wrap(result))
+    const ids = result.page.rows.map(item => item.value as ApiKeyId)
+    const meta = isAdmin ? await loadAttribution(repo, ids) : { metadata: await repo.usage.queryKeyMetadata(ids), refs: {} as Record<string, string> }
+    const names = new Map(meta.metadata.map(item => [item.keyId, item.keyName]))
+    const rows = result.page.rows.map(item => ({ value: isShared && view.ownerId ? sharedKeyRef(view.ownerId, item.value, secret) : item.value,
+      name: names.get(item.value as ApiKeyId) ?? item.value.slice(0, 8), groupRef: isAdmin ? meta.refs[item.value] ?? "_admin" : null }))
+    return c.json(await wrap({ ...result, page: { ...result.page, rows } }))
+  }
+  if (kind === "distribution" && axis) {
+    const result = await repo.usage.queryProjectionDistribution({ ...pageQuery, axis, groupRefs: fullAttribution?.refs })
+    const rows = axis === "key" && isShared && view.ownerId
+      ? result.page.rows.map(item => ({ ...item, value: sharedKeyRef(view.ownerId as UserId, item.value, secret) })) : result.page.rows
+    return c.json(await wrap({ ...result, page: { ...result.page, rows } }))
+  }
+  if (kind === "series" && axis && axis !== "incomingModel") {
+    const result = await repo.usage.queryProjectionSeries({ ...pageQuery, axis, groupRefs: fullAttribution?.refs })
+    const rows = axis === "key" && isShared && view.ownerId
+      ? result.page.rows.map(item => ({ ...item, value: sharedKeyRef(view.ownerId as UserId, item.value, secret) })) : result.page.rows
+    return c.json(await wrap({ ...result, page: { ...result.page, rows } }))
+  }
+  return c.json({ error: "Invalid projection" }, 400)
+}
+
+for (const kind of ["total", "facets", "participants", "distribution", "mappings", "time", "series"] as const) {
+  projectionRouter.get(`/${kind}`, c => respond(kind, c))
+}
diff --git a/vnext/packages/gateway/src/repo/usage-projections.ts b/vnext/packages/gateway/src/repo/usage-projections.ts
new file mode 100644
index 00000000..1adc6353
--- /dev/null
+++ b/vnext/packages/gateway/src/repo/usage-projections.ts
@@ -0,0 +1,261 @@
+import type { ApiKeyId } from "./branded-ids"
+import type { SqlExecutor } from "./shared/executor"
+import { buildUsageAccounting, usageMetrics, type UsageAccountingQuery, type UsageAccountingRow, type UsageOverviewMetrics } from "./usage-overview"
+
+export type UsageProjectionAxis = "key" | "client" | "model" | "incomingModel"
+export type UsageMetricAxis = UsageProjectionAxis | "user"
+export type UsageSeriesAxis = "key" | "client" | "model" | "user"
+export interface UsageProjectionQuery extends UsageAccountingQuery {
+  readonly keyId?: ApiKeyId
+  readonly keyIds?: readonly ApiKeyId[]
+  readonly filterKeyIds?: readonly ApiKeyId[]
+  readonly forceEmpty?: boolean
+}
+export interface UsagePageQuery extends UsageProjectionQuery {
+  readonly limit?: number
+  /** Raw identity cursor at the repo boundary; the HTTP layer encrypts it. */
+  readonly cursor?: string
+}
+export interface UsagePage<T> {
+  readonly rows: readonly T[]
+  readonly hasMore: boolean
+  readonly nextCursor: string | null
+}
+export interface UsageProjectionTotal {
+  readonly range: { readonly start: string; readonly end: string }
+  readonly total: UsageOverviewMetrics
+}
+export interface UsageFacet { readonly value: string; readonly name?: string; readonly groupRef?: string | null }
+export interface UsageFacetQuery extends UsagePageQuery { readonly axis: UsageProjectionAxis }
+export interface UsageFacetResult { readonly range: UsageProjectionTotal["range"]; readonly axis: UsageProjectionAxis; readonly page: UsagePage<UsageFacet> }
+export interface UsageParticipantEdge { readonly keyId: string; readonly role: "owner" | "assignee"; readonly userId: string; readonly name: string }
+export interface UsageParticipantQuery extends UsagePageQuery { readonly visibleRosterKeyIds?: readonly ApiKeyId[]; readonly visibleRosterOwnerId?: string }
+export interface UsageParticipantResult { readonly range: UsageProjectionTotal["range"]; readonly page: UsagePage<UsageParticipantEdge> }
+export interface UsageDistributionQuery extends UsagePageQuery { readonly axis: UsageMetricAxis; readonly groupRefs?: Readonly<Record<string, string>> }
+export interface UsageDistributionResult { readonly range: UsageProjectionTotal["range"]; readonly axis: UsageMetricAxis; readonly page: UsagePage<{ readonly value: string; readonly metrics: UsageOverviewMetrics }> }
+export interface UsageMapping { readonly incomingModel: string; readonly model: string }
+export interface UsageMappingResult { readonly range: UsageProjectionTotal["range"]; readonly page: UsagePage<UsageMapping> }
+export interface UsageProjectionTime { readonly range: UsageProjectionTotal["range"]; readonly unfilteredHasRecords: boolean; readonly buckets: readonly { readonly hour: string; readonly metrics: UsageOverviewMetrics }[] }
+export interface UsageSeriesQuery extends UsagePageQuery { readonly axis: UsageSeriesAxis; readonly groupRefs?: Readonly<Record<string, string>> }
+export interface UsageSeriesResult { readonly range: UsageProjectionTotal["range"]; readonly axis: UsageSeriesAxis; readonly page: UsagePage<{ readonly value: string; readonly hours: readonly { readonly hour: string; readonly metrics: UsageOverviewMetrics }[] }> }
+
+const column: Record<UsageProjectionAxis, string> = { key: "key_id", client: "client", model: "model", incomingModel: "incoming_model" }
+const range = (q: UsageProjectionQuery) => ({ start: q.start, end: q.end })
+
+export function validateUsageProjection(q: UsageProjectionQuery, timed = false): number {
+  const parse = (value: string): number => {
+    if (!/^\d{4}-\d{2}-\d{2}T\d{2}$/.test(value)) throw new Error("Expected UTC hour YYYY-MM-DDTHH")
+    const ms = Date.parse(`${value}:00:00Z`)
+    if (!Number.isFinite(ms) || new Date(ms).toISOString().slice(0, 13) !== value) throw new Error("Invalid UTC hour")
+    return ms
+  }
+  const first = parse(q.start), last = parse(q.end)
+  if (last <= first) throw new Error("end must be after start")
+  const hours = (last - first) / 3600000
+  if (Math.ceil(last / 86400000) - Math.floor(first / 86400000) > 366) throw new Error("Too many UTC calendar buckets")
+  if (timed && hours > 744) throw new Error("Too many UTC hours")
+  return hours
+}
+
+function pageLimit(q: UsagePageQuery): number {
+  const limit = q.limit ?? 200
+  if (!Number.isInteger(limit) || limit < 1 || limit > 200) throw new Error("limit must be 1..200")
+  if (q.cursor !== undefined && typeof q.cursor !== "string") throw new Error("Invalid cursor")
+  return limit
+}
+
+function presence(q: UsageProjectionQuery): { cte: string; args: unknown[] } {
+  const cond = ["hour >= ?", "hour < ?"]
+  const values: unknown[] = [q.start, q.end]
+  if (q.keyIds !== undefined) cond.push("key_id IN (SELECT value FROM scope_keys)")
+  if (q.filterKeyIds !== undefined) cond.push("key_id IN (SELECT value FROM filter_keys)")
+  if (q.forceEmpty) cond.push("1=0")
+  for (const [field, value] of [["key_id", q.keyId], ["client", q.client], ["model", q.model], ["incoming_model", q.incomingModel]] as const) {
+    if (value != null) { cond.push(`${field} = ?`); values.push(value) }
+  }
+  const where = cond.join(" AND ")
+  const scope = q.keyIds === undefined ? "" : "scope_keys AS (SELECT value FROM json_each(?)),"
+  const filter = q.filterKeyIds === undefined ? "" : "filter_keys AS (SELECT value FROM json_each(?)),"
+  return { cte: `WITH ${scope}${filter} presence AS (
+    SELECT key_id,incoming_model,model,client,hour FROM usage WHERE ${where}
+    UNION SELECT key_id,incoming_model,model,client,hour FROM usage_requests WHERE ${where}
+  )`, args: [...(q.keyIds === undefined ? [] : [JSON.stringify(q.keyIds)]),
+    ...(q.filterKeyIds === undefined ? [] : [JSON.stringify(q.filterKeyIds)]), ...values, ...values] }
+}
+
+function page<T>(rows: readonly T[], limit: number, cursorOf: (row: T) => string): UsagePage<T> {
+  const visible = rows.slice(0, limit)
+  const hasMore = rows.length > limit
+  const last = visible.at(-1)
+  return { rows: visible, hasMore, nextCursor: hasMore && last ? cursorOf(last) : null }
+}
+
+export async function queryUsageProjectionTotal(x: SqlExecutor, q: UsageProjectionQuery): Promise<UsageProjectionTotal> {
+  validateUsageProjection(q)
+  const { cte, args, sums } = buildUsageAccounting(q)
+  const rows = await x.all<UsageAccountingRow>(`${cte} SELECT '' AS value,${sums} FROM entries`, args)
+  return { range: range(q), total: usageMetrics(rows[0]) }
+}
+
+export async function queryUsageProjectionTime(x: SqlExecutor, q: UsageProjectionQuery): Promise<UsageProjectionTime> {
+  validateUsageProjection(q, true)
+  const { cte, args, sums } = buildUsageAccounting(q)
+  const unfiltered = presence({ start: q.start, end: q.end, keyIds: q.keyIds })
+  const [buckets, presenceRows] = await Promise.all([
+    x.all<UsageAccountingRow>(`${cte} SELECT hour AS value,${sums} FROM entries GROUP BY hour ORDER BY hour COLLATE BINARY`, args),
+    x.all<{ present: number }>(`${unfiltered.cte} SELECT EXISTS(SELECT 1 FROM presence) AS present`, unfiltered.args),
+  ])
+  return { range: range(q), unfilteredHasRecords: presenceRows[0]?.present === 1,
+    buckets: buckets.map(row => ({ hour: row.value, metrics: usageMetrics(row) })) }
+}
+
+export async function queryUsageProjectionFacets(x: SqlExecutor, q: UsageFacetQuery): Promise<UsageFacetResult> {
+  validateUsageProjection(q)
+  const limit = pageLimit(q)
+  if (!Object.hasOwn(column, q.axis)) throw new Error("Invalid axis")
+  if (q.keyId !== undefined || q.filterKeyIds !== undefined || q.client !== undefined || q.model !== undefined || q.incomingModel !== undefined) throw new Error("Facets do not accept active filters")
+  const { cte, args } = presence(q)
+  const field = column[q.axis]
+  const rows = await x.all<{ value: string }>(`${cte} SELECT DISTINCT ${field} AS value FROM presence
+    WHERE (? IS NULL OR ${field} COLLATE BINARY > ?) ORDER BY value COLLATE BINARY LIMIT ?`,
+    [...args, q.cursor ?? null, q.cursor ?? null, limit + 1])
+  return { range: range(q), axis: q.axis, page: page(rows, limit, row => row.value) }
+}
+
+export async function queryUsageProjectionMappings(x: SqlExecutor, q: UsagePageQuery): Promise<UsageMappingResult> {
+  validateUsageProjection(q)
+  const limit = pageLimit(q)
+  const tuple = q.cursor === undefined ? null : decodeTuple(q.cursor)
+  const { cte, args } = presence(q)
+  const rows = await x.all<UsageMapping>(`${cte} SELECT DISTINCT incoming_model AS incomingModel, model FROM presence
+    WHERE (? IS NULL OR incoming_model COLLATE BINARY > ? OR (incoming_model = ? AND model COLLATE BINARY > ?))
+    ORDER BY incoming_model COLLATE BINARY, model COLLATE BINARY LIMIT ?`,
+    [...args, tuple?.[0] ?? null, tuple?.[0] ?? null, tuple?.[0] ?? null, tuple?.[1] ?? null, limit + 1])
+  return { range: range(q), page: page(rows, limit, row => JSON.stringify([row.incomingModel, row.model])) }
+}
+
+function decodeTuple(value: string): [string, string] {
+  let parsed: unknown
+  try { parsed = JSON.parse(value) } catch { throw new Error("Invalid tuple cursor") }
+  if (!Array.isArray(parsed) || parsed.length !== 2 || typeof parsed[0] !== "string" || typeof parsed[1] !== "string") throw new Error("Invalid tuple cursor")
+  return [parsed[0], parsed[1]]
+}
+
+function decodeEdgeTuple(value: string): [string, number, string] {
+  let parsed: unknown
+  try { parsed = JSON.parse(value) } catch { throw new Error("Invalid tuple cursor") }
+  if (!Array.isArray(parsed) || parsed.length !== 3 || typeof parsed[0] !== "string" || (parsed[1] !== 0 && parsed[1] !== 1) || typeof parsed[2] !== "string") throw new Error("Invalid tuple cursor")
+  return [parsed[0], parsed[1], parsed[2]]
+}
+
+export async function queryUsageProjectionParticipants(x: SqlExecutor, q: UsageParticipantQuery): Promise<UsageParticipantResult> {
+  validateUsageProjection(q)
+  const limit = pageLimit(q)
+  if (q.keyId !== undefined || q.filterKeyIds !== undefined || q.client !== undefined || q.model !== undefined || q.incomingModel !== undefined) throw new Error("Participants do not accept active filters")
+  const tuple = q.cursor === undefined ? null : decodeEdgeTuple(q.cursor)
+  const { cte, args } = presence(q)
+  const ownerRoster = q.visibleRosterKeyIds !== undefined ? "AND p.key_id IN (SELECT value FROM json_each(?))" : ""
+  const ownerRosterArgs = q.visibleRosterKeyIds !== undefined ? [JSON.stringify(q.visibleRosterKeyIds)] : []
+  const assigneeRoster = q.visibleRosterKeyIds !== undefined ? "AND p.key_id IN (SELECT value FROM json_each(?))"
+    : q.visibleRosterOwnerId !== undefined ? "AND p.key_id IN (SELECT id FROM api_keys WHERE owner_id = ?)" : ""
+  const assigneeRosterArgs = q.visibleRosterKeyIds !== undefined ? [JSON.stringify(q.visibleRosterKeyIds)]
+    : q.visibleRosterOwnerId !== undefined ? [q.visibleRosterOwnerId] : []
+  const rows = await x.all<UsageParticipantEdge & { rank: number }>(`${cte}, used_keys AS (SELECT DISTINCT key_id FROM presence), edges AS (
+    SELECT p.key_id AS keyId,0 AS rank,'owner' AS role,k.owner_id AS userId,
+      COALESCE(u.name,substr(k.owner_id,1,8)) AS name
+    FROM used_keys p JOIN api_keys k ON k.id=p.key_id LEFT JOIN users u ON u.id=k.owner_id
+    WHERE NULLIF(k.owner_id,'') IS NOT NULL ${ownerRoster}
+    UNION ALL
+    SELECT p.key_id AS keyId,1 AS rank,'assignee' AS role,a.user_id AS userId,
+      COALESCE(u.name,substr(a.user_id,1,8)) AS name
+    FROM used_keys p JOIN key_assignments a ON a.key_id=p.key_id LEFT JOIN users u ON u.id=a.user_id
+    WHERE 1=1 ${assigneeRoster}
+  ) SELECT keyId,rank,role,userId,name FROM edges
+  WHERE (? IS NULL OR keyId COLLATE BINARY > ? OR (keyId = ? AND rank > ?)
+    OR (keyId = ? AND rank = ? AND userId COLLATE BINARY > ?))
+  ORDER BY keyId COLLATE BINARY,rank,userId COLLATE BINARY LIMIT ?`,
+  [...args, ...ownerRosterArgs, ...assigneeRosterArgs, tuple?.[0] ?? null, tuple?.[0] ?? null, tuple?.[0] ?? null,
+    tuple?.[1] ?? null, tuple?.[0] ?? null, tuple?.[1] ?? null, tuple?.[2] ?? null, limit + 1])
+  const result = page(rows, limit, item => JSON.stringify([item.keyId, item.rank, item.userId]))
+  return { range: range(q), page: { ...result, rows: result.rows.map(({ keyId, role, userId, name }) => ({ keyId, role, userId, name })) } }
+}
+
+const groupMap = (refs: Readonly<Record<string, string>> | undefined): { cte: string; bind: string } => ({
+  cte: "group_map AS MATERIALIZED (SELECT CAST(json_extract(value,'$[0]') AS TEXT) AS key_id,CAST(json_extract(value,'$[1]') AS TEXT) AS group_ref FROM json_each(?)),",
+  bind: JSON.stringify(Object.entries(refs ?? {})),
+})
+
+export async function queryUsageProjectionDistribution(x: SqlExecutor, q: UsageDistributionQuery): Promise<UsageDistributionResult> {
+  validateUsageProjection(q)
+  const limit = pageLimit(q)
+  if (q.axis !== "user" && !Object.hasOwn(column, q.axis)) throw new Error("Invalid axis")
+  const group = q.axis === "user" ? groupMap(q.groupRefs) : null
+  const { cte, args, sums } = buildUsageAccounting(q, group ? { ctes: group.cte, cteBinds: [group.bind] } : undefined)
+  // A scalar lookup lets SQLite seek the materialized map for each entry.
+  const identity = q.axis === "user" ? "COALESCE((SELECT group_ref FROM group_map WHERE group_map.key_id=e.key_id),'_admin')" : `e.${column[q.axis]}`
+  const rows = await x.all<UsageAccountingRow>(`${cte} SELECT ${identity} AS value,${sums} FROM entries e
+    WHERE (? IS NULL OR ${identity} COLLATE BINARY > ?) GROUP BY value ORDER BY value COLLATE BINARY LIMIT ?`,
+    [...args, q.cursor ?? null, q.cursor ?? null, limit + 1])
+  const result = page(rows, limit, item => item.value)
+  return { range: range(q), axis: q.axis, page: { ...result, rows: result.rows.map(item => ({ value: item.value, metrics: usageMetrics(item) })) } }
+}
+
+function presenceDefinition(q: UsageProjectionQuery): { definition: string; args: unknown[] } {
+  const source = presence(q)
+  const scope = q.keyIds === undefined ? "" : "scope_keys AS (SELECT value FROM json_each(?)),"
+  const filter = q.filterKeyIds === undefined ? "" : "filter_keys AS (SELECT value FROM json_each(?)),"
+  const prefix = `WITH ${scope}${filter}`
+  return { definition: `${source.cte.slice(prefix.length)},`,
+    args: source.args.slice(Number(q.keyIds !== undefined) + Number(q.filterKeyIds !== undefined)) }
+}
+
+export async function queryUsageProjectionSeries(x: SqlExecutor, q: UsageSeriesQuery): Promise<UsageSeriesResult> {
+  validateUsageProjection(q, true)
+  const limit = pageLimit(q)
+  if (!["key", "client", "model", "user"].includes(q.axis)) throw new Error("Invalid axis")
+  const group = q.axis === "user" ? groupMap(q.groupRefs) : null
+  const identity = q.axis === "user" ? "COALESCE(g.group_ref,'_admin')"
+    : q.axis === "key" ? "key_id" : `COALESCE(NULLIF(${q.axis},''),'unknown')`
+  const p = presenceDefinition(q)
+  const candidateJoin = group ? "LEFT JOIN group_map g ON g.key_id=presence.key_id" : ""
+  const entryIdentity = q.axis === "user" ? "COALESCE(g.group_ref,'_admin')"
+    : q.axis === "key" ? "e.key_id" : `COALESCE(NULLIF(e.${q.axis},''),'unknown')`
+  const selectionCondition = q.axis === "user"
+    ? "COALESCE((SELECT group_ref FROM group_map WHERE key_id=u.key_id),'_admin') IN (SELECT value FROM page_keys)"
+    : `${identity} IN (SELECT value FROM page_keys)`
+  const ctes = `${group?.cte ?? ""}${p.definition} identity_hours AS MATERIALIZED (
+    SELECT DISTINCT ${identity} AS value,hour FROM presence ${candidateJoin}
+    WHERE (? IS NULL OR ${identity} COLLATE BINARY > ?)
+  ), candidate_keys AS MATERIALIZED (
+    SELECT DISTINCT value FROM identity_hours ORDER BY value COLLATE BINARY LIMIT ?
+  ), candidates AS MATERIALIZED (
+    SELECT value,COUNT(*) AS occupied FROM identity_hours
+    WHERE value COLLATE BINARY IN (SELECT value FROM candidate_keys)
+    GROUP BY value
+  ), ranked AS MATERIALIZED (
+    SELECT value,ROW_NUMBER() OVER (ORDER BY value COLLATE BINARY) AS ordinal,
+      SUM(occupied) OVER (ORDER BY value COLLATE BINARY ROWS UNBOUNDED PRECEDING) AS running_cells
+    FROM candidates
+  ), page_keys AS MATERIALIZED (SELECT value FROM ranked WHERE ordinal <= ? AND running_cells <= 744),`
+  const cteBinds = [...(group ? [group.bind] : []), ...p.args, q.cursor ?? null, q.cursor ?? null, limit + 1, limit]
+  // Both accounting source branches use alias u, so the group lookup stays
+  // correlated to the current usage or usage_requests row.
+  const { cte, args, sums } = buildUsageAccounting(q, { ctes, cteBinds, condition: selectionCondition })
+  const join = group ? "LEFT JOIN group_map g ON g.key_id=e.key_id" : ""
+  type CellRow = UsageAccountingRow & { hour: string; hasMore: number }
+  const rows = await x.all<CellRow>(`${cte}, cells AS (
+    SELECT ${entryIdentity} AS value,e.hour AS hour,${sums} FROM entries e ${join}
+    GROUP BY value,e.hour
+  ) SELECT cells.*,(SELECT COUNT(*) FROM candidates) > (SELECT COUNT(*) FROM page_keys) AS hasMore
+    FROM cells JOIN page_keys USING(value) ORDER BY value COLLATE BINARY,hour COLLATE BINARY`, args)
+  const series = new Map<string, { value: string; hours: { hour: string; metrics: UsageOverviewMetrics }[] }>()
+  for (const item of rows) {
+    let entry = series.get(item.value)
+    if (!entry) { entry = { value: item.value, hours: [] }; series.set(item.value, entry) }
+    entry.hours.push({ hour: item.hour, metrics: usageMetrics(item) })
+  }
+  const visible = [...series.values()]
+  const last = visible.at(-1)
+  const hasMore = rows[0]?.hasMore === 1
+  return { range: range(q), axis: q.axis, page: { rows: visible, hasMore, nextCursor: hasMore && last ? last.value : null } }
+}

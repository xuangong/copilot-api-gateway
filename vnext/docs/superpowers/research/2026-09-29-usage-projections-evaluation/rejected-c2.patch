+  const metrics = { requests: 0, input: 0, output: 0, cacheRead: 0, cacheCreation: 0,
+    costUSD: 0, hasRecords: true, unpricedTokens: 0, unpricedDimensionRows: 1, observedDimensions: ["input"] }

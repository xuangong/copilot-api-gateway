+    async function exhaust<T>(fetch: (cursor?: string) => Promise<{ page: { rows: readonly T[]; nextCursor: string | null } }>) {
+      const rows: T[] = []
+      let cursor: string | undefined
+      do {
+        const result = await fetch(cursor)
+        expect(result.page.rows.length).toBeLessThanOrEqual(200)
+        rows.push(...result.page.rows)
+        cursor = result.page.nextCursor ?? undefined
+      } while (cursor !== undefined)
+      return rows
+    }
+    const models = await exhaust(cursor => repo.usage.queryProjectionFacets({ start, end, axis: "model", cursor }))
+    expect(new Set(models.map(item => item.value)).size).toBe(410)
+    const mappings = await exhaust(cursor => repo.usage.queryProjectionMappings({ start, end, cursor }))

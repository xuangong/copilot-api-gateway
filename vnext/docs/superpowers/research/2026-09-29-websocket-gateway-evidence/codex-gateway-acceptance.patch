+/// Runs the pinned client against the clean vNext Bun app in the scratch gateway fixture.
+/// The fixture provides only local SQLite/key state and a counted loopback upstream.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn gateway_426_fallback_acceptance() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let gateway_base = std::env::var("C11_GATEWAY_BASE")?;
+    let api_key = std::env::var("C11_GATEWAY_KEY")?;
+    let harness_server = responses::start_mock_server().await;
+    let mut builder = test_codex()
+        .with_auth(CodexAuth::from_api_key(&api_key))
+        .with_config({
+            let base_url = format!("{gateway_base}/v1");
+            move |config| {
+                config.model_provider.base_url = Some(base_url);
+                config.model_provider.wire_api = WireApi::Responses;
+                config.model_provider.supports_websockets = true;
+                config.model_provider.stream_max_retries = Some(0);
+                config.model_provider.request_max_retries = Some(0);
+            }
+        });
+    let test = builder.build(&harness_server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "hello".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let terminal = timeout(Duration::from_secs(20), async {
+        loop {
+            let event = test.codex.next_event().await.expect("Codex event stream closed").msg;
+            if let EventMsg::TurnComplete(terminal) = event {
+                break terminal;
+            }
+        }
+    })
+    .await?;
+    assert!(terminal.error.is_none(), "Codex turn failed: {:?}", terminal.error);
 
+    let authority = gateway_base.strip_prefix("http://").unwrap_or(&gateway_base);
+    let mut conn = TcpStream::connect(authority).await?;
+    conn.write_all(b"GET /__fixture/counts HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")
+        .await?;
+    let mut wire = Vec::new();
+    conn.read_to_end(&mut wire).await?;
+    let separator = b"\r\n\r\n";
+    let body_start = wire.windows(separator.len()).position(|part| part == separator)
+        .ok_or_else(|| anyhow::anyhow!("fixture count response missing HTTP header boundary"))?
+        + separator.len();
+    let counts: serde_json::Value = serde_json::from_slice(&wire[body_start..])?;
+    eprintln!("C11 gateway fixture counts: {counts}");
+    assert_eq!(counts["get"].as_u64(), Some(1));
+    assert_eq!(counts["getStatuses"][0].as_u64(), Some(426));
+    assert_eq!(counts["post"].as_u64(), Some(1));
+    assert_eq!(counts["postStatuses"][0].as_u64(), Some(200));
+    assert_eq!(counts["upstream"].as_u64(), Some(1));
+
     Ok(())
 }
 

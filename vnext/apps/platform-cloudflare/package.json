{
  "name": "@vibe-llm/platform-cloudflare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply copilot-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply copilot-db --local",
    "build:ui": "bun ../../scripts/build-dashboard.ts",
    "deploy": "bun run build:ui && wrangler deploy",
    "deploy:full": "bun run build:ui && bun run db:migrate && wrangler deploy",
    "deploy:dry": "bun run build:ui && wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@vibe-llm/gateway": "workspace:*",
    "@vibe-core/platform": "workspace:*",
    "@vibe-llm/responses-store": "workspace:*",
    "@vibe-core/cache": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "wrangler": "^4.97.0"
  }
}
